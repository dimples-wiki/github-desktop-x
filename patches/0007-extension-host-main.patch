+// Product-rename continuity (GitHub Desktop Dimple → GitHub Desktop X):
+// carry the previous userData folder over once, so plugins, settings and
+// recent repositories survive the rename. Must run before the single
+// instance lock, which is keyed on the userData path.
+{
+  const appData = app.getPath('appData')
+  const userData = Path.join(appData, 'GitHub Desktop X')
+  const legacy = Path.join(appData, 'GitHub Desktop Dimple')
+  const isEmptyDir = (p: string) => {
+    try {
+      return Fs.readdirSync(p).length === 0
+    } catch {
+      return false
+    }
+  }
+  if (Fs.existsSync(legacy) && (!Fs.existsSync(userData) || isEmptyDir(userData))) {
+    try {
+      Fs.renameSync(legacy, userData)
+      log.info(`Migrated legacy userData to ${userData}`)
+    } catch (e) {
+      log.error('Legacy userData migration failed', e)
+    }
+  }
+  app.setPath('userData', userData)
+}
