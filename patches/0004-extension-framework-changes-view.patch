+  /**
+   * 文件夹右键菜单：以文件夹身份适配原生菜单项。
+   * - Discard Changes 作用于文件夹下所有文件（含子目录）
+   * - Ignore Folder 忽略整个文件夹路径
+   * - 文件夹没有默认打开程序关联 → 该项禁用
+   */
+  private getDefaultContextMenuForFolder = (
+    folderPath: string,
+    files: ReadonlyArray<WorkingDirectoryFileChange>
+  ): ReadonlyArray<IMenuItem> => {
+    const paths = files.map(f => f.path)
+    // 文件夹桩对象：菜单项助手只读取 path/status
+    const folderStub = {
+      id: `folder:${folderPath}`,
+      path: folderPath,
+      status: { kind: AppFileStatusKind.Modified },
+    } as WorkingDirectoryFileChange
+
+    const items: IMenuItem[] = [
+      this.getDiscardChangesMenuItem(
+        files.length > 0 ? paths : [folderPath]
+      ),
+      { type: 'separator' },
+      {
+        label: __DARWIN__
+          ? 'Ignore Folder (Add to .gitignore)'
+          : 'Ignore folder (add to .gitignore)',
+        action: () => this.props.onIgnoreFile(folderPath),
+      },
+    ]
+
+    if (files.length > 1) {
+      items.push(
+        { type: 'separator' },
+        {
+          label: __DARWIN__
+            ? 'Include All Files in Folder'
+            : 'Include all files in folder',
+          action: () => files.map(f => this.props.onIncludeChanged(f, true)),
+        },
+        {
+          label: __DARWIN__
+            ? 'Exclude All Files in Folder'
+            : 'Exclude all files in folder',
+          action: () => files.map(f => this.props.onIncludeChanged(f, false)),
+        },
+      )
+    }
+
+    items.push(
+      { type: 'separator' },
+      this.getCopyPathMenuItem(folderStub),
+      this.getCopyRelativePathMenuItem(folderStub),
+      { type: 'separator' },
+      this.getRevealInFileManagerMenuItem(folderStub),
+      this.getOpenInExternalEditorMenuItem(folderStub, true),
+      {
+        label: OpenWithDefaultProgramLabel,
+        enabled: false,
+      }
+    )
+
+    return items
+  }
+
+  /** Tree 插件的文件夹右键桥：原生菜单 + 文件夹身份适配 */
+  private onChangesFolderViewContextMenu = (
+    folderPath: string,
+    files: ReadonlyArray<WorkingDirectoryFileChange>,
+    event: React.MouseEvent<HTMLDivElement>
+  ) => {
+    if (this.props.isCommitting) {
+      return
+    }
+
+    event.preventDefault()
+
+    const items = this.getDefaultContextMenuForFolder(folderPath, files)
+    showContextualMenu(items)
+  }
